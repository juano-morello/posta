# --- secrets ---------------------------------------------------------------
# .env.example is committed; every other .env flavour is not.
.env
.env.*
!.env.example

# --- dependencies ----------------------------------------------------------
node_modules/
.pnpm-store/
.pnp.*
.yarn/

# --- build output ----------------------------------------------------------
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- test & coverage -------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/

# apps/worker/src/test/pipeline-harness-process.ts's cross-process build
# mutex — deliberately outside dist/ (see that file's own comment on
# BUILD_LOCK_PATH), so it needs its own explicit entry rather than
# riding dist/'s blanket ignore above.
.pipeline-harness-build.lock

# --- data files ------------------------------------------------------------
# GeoLite2 ASN database (S2.3) — downloaded at build time, MaxMind-licensed,
# ~8MB binary. Never commit it.
*.mmdb
data/geoip/

# --- local infrastructure --------------------------------------------------
# docker-compose volumes (S0.4)
.docker/
postgres-data/
redis-data/
minio-data/

# --- logs ------------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# --- editors & OS ----------------------------------------------------------
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db

# --- misc ------------------------------------------------------------------
.cache/
tmp/
*.local

# SDD scratch (briefs, reports, review packages)
.superpowers/

# Serena's per-project config. Ships its own .gitignore covering /cache and
# /project.local.yml, and its project.yml is designed to be versioned — but
# project.yml's `project_name` is generated from the CHECKOUT directory, so
# every .claude/worktrees/* worktree writes a different value into it. In a
# repo that uses worktrees routinely that is pure churn on a file no shared
# setting depends on, so it is ignored wholesale rather than committed.
.serena/
