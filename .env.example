# Posta — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is committed.
# Every value here is validated at startup by a Zod schema (plan S0.3) — a
# missing key crashes the process on boot instead of surfacing as a 500 later.

# ============================================================================
# DOMAINS
# ============================================================================
# The single source of truth for every host Posta constructs. Nothing in the
# codebase may contain a literal domain — a grep test (T0.3.5) enforces this,
# which is what makes moving to a fallback domain a config change rather than
# a code change if `posta.lat` turns out to be unavailable (T10.1.1).
#
#   links     <handle>.${POSTA_LINK_DOMAIN}/<slug>   juano.posta.lat/promo
#   bio       <handle>.${POSTA_LINK_DOMAIN}/         juano.posta.lat/
#   dashboard app.${POSTA_LINK_DOMAIN}               app.posta.lat
#   api       api.${POSTA_LINK_DOMAIN}               api.posta.lat
POSTA_LINK_DOMAIN=posta.lat

# Subdomain labels, split out so they are overridable without touching code.
# The dashboard and API hosts are derived as <label>.${POSTA_LINK_DOMAIN}.
POSTA_APP_SUBDOMAIN=app
POSTA_API_SUBDOMAIN=api

# Protocol for constructed URLs. `http` locally, `https` everywhere else.
POSTA_PROTOCOL=https

# Handles that can never be claimed by a tenant, because they collide with the
# hosts above or with future infrastructure. Shared by the redirect hot path
# (S2.1) and slug validation (S5.3) — one list, never a copy.
POSTA_RESERVED_HANDLES=app,api,www,admin,static,assets,cdn,mail,blog,docs,status

# ============================================================================
# DATASTORES  — all three must be co-located in São Paulo in production (S10.4)
# ============================================================================
DATABASE_URL=postgresql://posta:posta@localhost:5432/posta

# Pool `max` is explicit and env-supplied (T1.1.1), never left to the pg
# driver default (10). Under Kubernetes the api scales horizontally, so
# total connections are `pool.max × replicas + worker + migration Job` —
# that product must stay under the managed tier's connection cap, or the
# HPA scaling up under load is what exhausts the database (E10/S10.7 checks
# the arithmetic against the chosen tier). Low locally since one dev
# process never needs many connections.
DB_POOL_MAX=10

# Discrete credentials for the Postgres container (docker-compose, S0.4) —
# the official postgres image reads these three env vars directly; it
# cannot parse a connection URL. Local dev only, and MUST stay in sync
# with the posta:posta@localhost:5432/posta credentials embedded in
# DATABASE_URL/DATABASE_URL_WORKER above — change one, change all three.
POSTGRES_USER=posta
POSTGRES_PASSWORD=posta
POSTGRES_DB=posta

# The worker connects as the writer role; the API (above) connects as a
# reader with no SELECT on raw `events` (T4.2.4). In local dev both point
# at the same Postgres with the same creds — the privilege separation
# doesn't exist yet — but the two-URL split is wired from the start so it
# only needs a value change, not a code change, once T4.2.4 lands.
DATABASE_URL_WORKER=postgresql://posta:posta@localhost:5432/posta

# Redis does double duty: hot link cache (TTL'd keys) and the BullMQ event bus
# (no TTL). The managed instance MUST run `maxmemory-policy volatile-lru` — under
# `allkeys-lru` a queue backlog silently evicts its own jobs and events vanish.
# Verify this on the provider, not just in docker-compose (T10.3.4).
REDIS_URL=redis://localhost:6379

# ============================================================================
# CLOUDFLARE R2  — the source of truth for events (invariant 7)
# ============================================================================
R2_ACCOUNT_ID=
# Local dev default (docker-compose, S0.4) — MinIO's root user/password
# are set FROM these same two values (see docker-compose.yml's minio
# service), so the app and MinIO always agree with no separate MINIO_*
# vars to keep in sync. Production overrides both with real R2 API
# token credentials; never reuse this dev value there.
R2_ACCESS_KEY_ID=posta-local-dev
R2_SECRET_ACCESS_KEY=posta-local-dev-secret
R2_BUCKET_EVENTS=posta-events
R2_BUCKET_AVATARS=posta-avatars
# Local dev points at MinIO; production leaves this empty to use the R2 default.
R2_ENDPOINT=http://localhost:9000

# ============================================================================
# GEOIP  — ASN lookup at capture, before the IP is dropped (S2.3)
# ============================================================================
# DB-IP lite databases, CC BY 4.0 — no account, no licence key. Fetched by
# scripts/fetch-geoip.sh and baked into the container image at build time, which
# is only possible because the licence permits redistribution.
#
# TWO files are required: the ASN database carries no country data.
#   dbip-asn-lite.mmdb      → which network owns the IP (classification rule 6)
#   dbip-country-lite.mmdb  → country, when CF-IPCountry is absent
#
# A missing or corrupt file fails startup loudly. It must never degrade
# silently: an API running without an ASN reader emits asn:null on every event,
# rule 6 never fires, and the product looks healthy while detecting less.
GEOIP_DB_DIR=./data/geoip

# ============================================================================
# AUTH  — Better Auth (S5.1)
# ============================================================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://app.posta.lat

# The single seeded v1 account. There is no public signup route — not disabled,
# absent. tenant_id == user_id (invariant 9).
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_HANDLE=juano

# ============================================================================
# SERVICES
# ============================================================================
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3001
WORKER_PORT=3002
WEB_PORT=3000

# Browser-exposed. Must be a public URL — never put a secret behind NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=https://api.posta.lat

# Shared secret for the API → Next on-demand revalidation webhook fired on bio
# save (S8.6). Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# ============================================================================
# EVENT PIPELINE  — batching (S3.3). Flush on whichever trips first.
# ============================================================================
# R2 bills per PUT, so one object per click is real money at any volume.
EVENT_BATCH_SIZE=100
EVENT_BATCH_INTERVAL_MS=2000

# Redis TTL for resolved slug→destination lookups. Link edits invalidate this
# explicitly (T5.4.5) — without that, a fixed destination stays wrong for the
# full TTL and the user has no way to tell.
LINK_CACHE_TTL_SECONDS=3600

# How long (ms) the redirect hot path waits on a single Redis GET/SETEX
# (link cache or handle cache) before treating it as a miss and falling
# through to Postgres. A hung Redis must cost latency, not availability
# (invariant 1) — this is the bound. 30ms is a worst-case ceiling, not the
# expected cost: a healthy Redis answers in well under a millisecond.
REDIS_LOOKUP_TIMEOUT_MS=30

# How many enqueueCapture() calls (redirect/enqueue.ts) may have an
# outstanding BullMQ queue.add() in flight at once. Past this bound,
# further calls are dropped and counted (posta_enqueue_dropped_total)
# instead of piling up unresolved promises against a stalled queue — a
# stalled queue must cost events, never the process (invariant 1). 1000
# is a generous ceiling for a healthy queue; it only matters once
# Redis/BullMQ is already in trouble.
MAX_INFLIGHT_ENQUEUES=1000
