{
  "name": "@posta/core",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/test/index.d.ts",
      "default": "./dist/test/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "migrate": "dotenv -e ../../.env -- node dist/db/migrate.js",
    "migrate:status": "dotenv -e ../../.env -- node dist/db/migrate-status.js",
    "migrate:down": "dotenv -e ../../.env -- node dist/db/migrate-down.js",
    "vendor:asn": "bash scripts/vendor-asn.sh",
    "seed:asn": "dotenv -e ../../.env -- node scripts/seed-asn.ts",
    "seed": "dotenv -e ../../.env -- node scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@posta/contracts": "workspace:*",
    "better-auth": "^1.6.24",
    "bullmq": "^5.80.10",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "maxmind": "^5.0.6",
    "pg": "^8.22.0",
    "ua-parser-js": "^2.0.10",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@testcontainers/redis": "^12.0.4",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "5.9.3"
  }
}
